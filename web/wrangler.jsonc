{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildmalaysia",
  "account_id": "9c006d850453ab5c068f5688d138521b",
  // worker.ts redirects www and caches pages, then hands requests to Astro.
  "main": "./worker.ts",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "buildmalaysia.com", "custom_domain": true },
    { "pattern": "www.buildmalaysia.com", "custom_domain": true },
  ],
  "assets": { "binding": "ASSETS" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b5a46a67958f4fb4b922b16d0db833f3",
      // Local runs use this instead. Override it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE if your Postgres differs.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/buildmalaysia",
    },
  ],
  // The blog (EmDash): posts in D1, images in R2, admin sign-in sessions in KV. All three are in APAC.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildmalaysia-blog",
      "database_id": "496c92d9-bc08-4e75-b735-08db28bc3218",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "buildmalaysia-blog-media" }],
  "kv_namespaces": [{ "binding": "SESSION", "id": "d1bdb82c5b5d45e4bee9e5bd0d3e087f" }],
  // Runs worker.ts's scheduled handler: publishes scheduled posts and runs EmDash's backups.
  "triggers": { "crons": ["* * * * *"] },
  // The site is served only on its own domain.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The Resend segment alerts go to and the topic subscribers opt in to. Not secret.
  "vars": {
    "RESEND_SEGMENT_ID": "14fa098d-760b-48d3-920e-374c78508ee8",
    "RESEND_TOPIC_ID": "990c84d1-4480-4a6e-9043-571d699b8509",
    // The blog admin's address: passkeys and sign-in links are tied to it.
    "EMDASH_SITE_URL": "https://buildmalaysia.com",
  },
  // Set with `wrangler secret put`; listed so `wrangler types` declares them.
  "secrets": { "required": ["RESEND_API_KEY", "SUBSCRIBE_SECRET"] },
  // Sign-ups per client IP: 5 a minute. Counted per Cloudflare location, so approximate.
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
