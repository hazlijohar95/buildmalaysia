{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildmalaysia",
  "account_id": "9c006d850453ab5c068f5688d138521b",
  // worker.ts redirects www and caches pages, then hands requests to the Next app.
  "main": "worker.ts",
  "alias": { "next-app": "./.open-next/worker.js" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "buildmalaysia.com", "custom_domain": true },
    { "pattern": "www.buildmalaysia.com", "custom_domain": true },
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b5a46a67958f4fb4b922b16d0db833f3",
      // Local runs use this instead. Override it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE if your Postgres differs.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/buildmalaysia",
    },
  ],
  // The site is served only on its own domain.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Sign-ups per client IP: 5 a minute. Counted per Cloudflare location, so approximate.
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
