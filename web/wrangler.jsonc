{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildmalaysia",
  "account_id": "9c006d850453ab5c068f5688d138521b",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "buildmalaysia.com", "custom_domain": true },
    { "pattern": "www.buildmalaysia.com", "custom_domain": true },
  ],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The memory queue revalidates ISR pages by calling the worker itself.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "buildmalaysia" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "buildmalaysia-opennext-cache" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b5a46a67958f4fb4b922b16d0db833f3",
      // Local runs and the build use this instead. Override it with
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE if your Postgres differs.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/buildmalaysia",
    },
  ],
  "observability": { "enabled": true },
}
