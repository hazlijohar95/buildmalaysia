---
import Base from "@/layouts/Base.astro";
import { Band, kicker, pageTitle } from "@/components/Boxed";
import { decodeSlug, getEmDashEntry } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { coverUrl, readingMinutes } from "@/lib/blog";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const { entry: post, error } = await getEmDashEntry("posts", slug);
if (error) throw error;
if (!post) return Astro.rewrite("/404");

const dateFormat = new Intl.DateTimeFormat("en-MY", { day: "numeric", month: "long", year: "numeric" });
const cover = post.data.featured_image;
const minutes = readingMinutes(post.data.content);
const coverSrc = coverUrl(cover);
---

<Base
  title={post.data.title}
  description={post.data.excerpt ?? undefined}
  og={cover && coverSrc ? { path: coverSrc, alt: cover.alt ?? post.data.title, width: cover.width, height: cover.height } : undefined}
>
  <Band>
    <article class="mx-auto max-w-3xl">
      <a href="/blog" class:list={[kicker, "text-charcoal-700 no-underline hover:text-biru-800"]}>← Blog</a>
      <h1 class:list={["mt-4", pageTitle]} {...post.edit.title}>{post.data.title}</h1>
      {
        post.data.excerpt && (
          <p class="mt-5 mb-0 text-xl leading-relaxed text-charcoal-800 md:text-2xl md:leading-relaxed">
            {post.data.excerpt}
          </p>
        )
      }
      <div class:list={["mt-6 flex flex-wrap gap-x-3 gap-y-1 text-charcoal-700", kicker]}>
        <span>Build Malaysia</span>
        {
          post.data.publishedAt && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={post.data.publishedAt.toISOString()}>{dateFormat.format(post.data.publishedAt)}</time>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
      {
        cover && (
          <div class="mt-10 border-2 border-foreground">
            <Image image={cover} priority />
          </div>
        )
      }
      <div class="blog-prose mt-10 text-lg leading-relaxed text-charcoal-800" {...post.edit.content}>
        <PortableText value={post.data.content} />
      </div>
    </article>
  </Band>
</Base>

<style>
  .blog-prose :global(h2) {
    margin: 3rem 0 1rem;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
  }
  .blog-prose :global(h3) {
    margin: 2rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .blog-prose :global(p),
  .blog-prose :global(ul),
  .blog-prose :global(ol),
  .blog-prose :global(blockquote) {
    margin: 0 0 1.25rem;
  }
  .blog-prose :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .blog-prose :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .blog-prose :global(li + li) {
    margin-top: 0.5rem;
  }
  .blog-prose :global(li::marker) {
    color: var(--color-merah-600);
  }
  .blog-prose :global(a) {
    color: var(--color-biru-800);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .blog-prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .blog-prose :global(blockquote) {
    border-left: 4px solid var(--color-foreground);
    padding-left: 1.25rem;
    font-style: italic;
  }
  .blog-prose :global(figure) {
    margin: 2.5rem 0;
  }
  .blog-prose :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .blog-prose :global(figcaption) {
    margin-top: 0.75rem;
    text-align: left;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-charcoal-700);
  }
</style>
